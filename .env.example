# Copy to .env and adjust. .env is gitignored.

# development | testing | production
SPLITMATE_CONFIG=development

# Signs the session cookie and CSRF tokens. Generate a real one for production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me

# Any SQLAlchemy URL. Defaults to instance/splitmate.db when unset.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/splitmate

# Currency used for new accounts and groups.
DEFAULT_CURRENCY=INR

# Set to true only when the app is served over HTTPS.
SESSION_COOKIE_SECURE=false

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Test and coverage artefacts
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Flask instance folder: local SQLite database, uploads, anything machine-local
instance/
*.db
*.sqlite
*.sqlite3

# Logs
logs/
*.log

# Editor and OS cruft
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Merge and patch leftovers
*.orig
*.rej
*.bak

# Any dotfile ending in .env, whatever it is called. A credentials file was
# committed to a sibling repo once as `.workos-delpoy.env` - a typo of "deploy" -
# which slid straight past a rule naming the correct spelling. Match the shape,
# not the name, because the name is the part that gets typed wrong.
.env
.env.local
*.env
!.env.example
